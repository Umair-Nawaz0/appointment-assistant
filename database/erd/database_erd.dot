        >
    ];

    // Appointments
    appointments [
        label=<
            <table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#1e293b" style="rounded">
                <tr><td colspan="3" bgcolor="#ec4899" align="center"><b><font color="#ffffff" point-size="12">appointments</font></b></td></tr>
                <tr><td align="left"><font color="#f59e0b"><b>PK</b></font></td><td align="left"><b><font color="#f8fafc">id</font></b></td><td align="right"><font color="#94a3b8">uuid</font></td></tr>
                <tr><td align="left"><font color="#06b6d4"><b>FK</b></font></td><td align="left"><b><font color="#f8fafc">business_id</font></b></td><td align="right"><font color="#94a3b8">uuid</font></td></tr>
                <tr><td align="left"><font color="#06b6d4"><b>FK</b></font></td><td align="left"><b><font color="#f8fafc">customer_id</font></b></td><td align="right"><font color="#94a3b8">uuid</font></td></tr>
                <tr><td align="left"><font color="#06b6d4"><b>FK</b></font></td><td align="left"><font color="#f8fafc">conversation_id</font></td><td align="right"><font color="#64748b">uuid NULL</font></td></tr>
                <tr><td align="left"></td><td align="left"><font color="#f8fafc">status</font></td><td align="right"><font color="#94a3b8">appointment_status</font></td></tr>
                <tr><td align="left"></td><td align="left"><font color="#f8fafc">scheduled_start</font></td><td align="right"><font color="#94a3b8">timestamptz</font></td></tr>
                <tr><td align="left"></td><td align="left"><font color="#f8fafc">scheduled_end</font></td><td align="right"><font color="#94a3b8">timestamptz</font></td></tr>
                <tr><td align="left"></td><td align="left"><font color="#f8fafc">customer_name</font></td><td align="right"><font color="#64748b">text NULL</font></td></tr>
                <tr><td align="left"></td><td align="left"><font color="#f8fafc">customer_phone</font></td><td align="right"><font color="#64748b">text NULL</font></td></tr>
                <tr><td align="left"></td><td align="left"><font color="#f8fafc">customer_email</font></td><td align="right"><font color="#64748b">text NULL</font></td></tr>
                <tr><td align="left"></td><td align="left"><font color="#f8fafc">created_at</font></td><td align="right"><font color="#94a3b8">timestamptz</font></td></tr>
                <tr><td align="left"></td><td align="left"><font color="#f8fafc">updated_at</font></td><td align="right"><font color="#94a3b8">timestamptz</font></td></tr>
            </table>
        >
    ];

    // Relationships
    title -> businesses [style=invis];

    businesses -> business_settings [label="1 : 1", color="#38bdf8"];
    businesses -> business_hours [label="1 : 0..7", color="#38bdf8"];
    businesses -> business_schedule_overrides [label="1 : many", color="#38bdf8"];
    businesses -> business_auth_codes [label="1 : many", color="#94a3b8"];
    businesses -> business_sessions [label="1 : many", color="#94a3b8"];
    businesses -> customers [label="1 : many", color="#34d399"];
    businesses -> conversations [label="1 : many", color="#a78bfa"];
    businesses -> appointments [label="1 : many", color="#f472b6"];

    customers -> conversations [label="0..1 : many\n(nullable customer_id)", color="#34d399", style=dashed];
    customers -> appointments [label="1 : many\n(booking created)", color="#34d399"];

    conversations -> conversation_messages [label="1 : many\n(ordered timeline)", color="#a78bfa"];
    conversations -> conversation_state [label="open 1 : 1\n(closed 1 : 0)", color="#a78bfa"];
    conversations -> appointments [label="0..1 : many\n(optional booking ref)", color="#f472b6", style=dashed];
}
