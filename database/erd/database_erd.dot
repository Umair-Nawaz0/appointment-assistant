                <tr><td align="left"></td><td align="left"><font color="#f8fafc">created_at</font></td><td align="right"><font color="#94a3b8">timestamptz</font></td></tr>
                <tr><td align="left"></td><td align="left"><font color="#f8fafc">updated_at</font></td><td align="right"><font color="#94a3b8">timestamptz</font></td></tr>
