                <tr><td align="left"><font color="#10b981"><b>UQ</b></font></td><td align="left"><font color="#f8fafc">external_message_id</font></td><td align="right"><font color="#64748b">text NULL</font></td></tr>
                <tr><td align="left"></td><td align="left"><font color="#f8fafc">metadata</font></td><td align="right"><font color="#94a3b8">jsonb</font></td></tr>
                <tr><td align="left"></td><td align="left"><font color="#f8fafc">sent_at</font></td><td align="right"><font color="#94a3b8">timestamptz</font></td></tr>
