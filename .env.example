# ==============================================================================
# AI Appointment Assistant & n8n Environment Configuration
# ==============================================================================

# Project Name for Docker Compose
COMPOSE_PROJECT_NAME=appointment-assistant

# Environment mode (development / production)
NODE_ENV=development

# ------------------------------------------------------------------------------
# Backend & API Configuration
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=4000
APP_URL=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000,http://127.0.0.1:4000,http://localhost:5678,http://127.0.0.1:5678

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Inside Docker container, backend connects to "db". If running on host, use localhost.
PGHOST=db
PGPORT=5432
PG_HOST_PORT=5433
PGDATABASE=apointment_assitant
PGUSER=postgres
PGPASSWORD=postgres

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
SESSION_COOKIE_NAME=appointment_session
SESSION_TTL_DAYS=7
EMAIL_VERIFICATION_CODE_TTL_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=60

# Email Delivery: Use "console" for local development or "smtp" in production
MAIL_MODE=console
MAIL_FROM=Appointment Assistant <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=

# ------------------------------------------------------------------------------
# n8n Workflow Automation Configuration
# ------------------------------------------------------------------------------
N8N_IMAGE=docker.n8n.io/n8nio/n8n:latest
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Karachi
TZ=Asia/Karachi
N8N_ENCRYPTION_KEY=replace-with-a-long-random-value
N8N_SECURE_COOKIE=false
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_RUNNERS_MODE=internal
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=true
N8N_TEMPLATES_ENABLED=true
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# LLM API Keys for n8n Workflows
GROQ_API_KEY=
