NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
# Optional comma-separated additional browser origins.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local peer-authenticated PostgreSQL defaults
PGHOST=/var/run/postgresql
PGPORT=5432
PGDATABASE=apointment_assitant
PGUSER=umair
PGPASSWORD=

SESSION_COOKIE_NAME=appointment_session
SESSION_TTL_DAYS=7
EMAIL_VERIFICATION_CODE_TTL_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=60

# Use "console" locally. Set to "smtp" and provide SMTP values in production.
MAIL_MODE=console
MAIL_FROM=Appointment Assistant <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
