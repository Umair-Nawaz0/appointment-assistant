{
  "name": "appointment-assistant-dashboard",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,green \"backend/.venv/bin/uvicorn backend.app.main:app --reload --host 127.0.0.1 --port 4000\" \"npm run dev --workspace frontend\"",
    "dev:backend": "backend/.venv/bin/uvicorn backend.app.main:app --reload --host 127.0.0.1 --port 4000",
    "build": "npm run build --workspace frontend",
    "typecheck": "npm run typecheck --workspace frontend",
    "test:backend": "backend/.venv/bin/pytest -q backend/tests",
    "start": "backend/.venv/bin/uvicorn backend.app.main:app --host 127.0.0.1 --port 4000"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": { "node": ">=22" }
}
